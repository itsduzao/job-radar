# Job Radar - Environment Variables
# Copie para .env e preencha os valores
# cp .env.example .env

# ============================================
# LINKEDIN SOURCE (opcional se só testar Gupy)
# ============================================
# Cookie de sessão 'li_at' do LinkedIn (obrigatório para LinkedIn real)
# Obtenha em: DevTools > Application > Cookies > linkedin.com > li_at
LI_COOKIE=

# ============================================
# TELEGRAM (obrigatório para digest real)
# ============================================
# Token do bot (via @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID do destino (grupo/canal/usuario)
# Use @userinfobot ou @getidsbot para descobrir
TELEGRAM_CHAT_ID=

# ============================================
# GEMINI (obrigatório para triagem real)
# ============================================
# Chave API em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================
# GUPY SOURCE (nova feature)
# ============================================
# Ativar fonte Gupy (default: false)
ENABLE_GUPY_SOURCE=true

# Dry-run: só coleta e loga, NÃO faz triagem nem envia digest (default: false)
# Útil para validar coleta sem ruído no Telegram
GUPY_DRY_RUN=false

# Máximo de páginas por query (default: 20)
# Cada página = 50 vagas; 20 páginas = 1000 vagas/query
GUPY_MAX_PAGES=20

# Filtrar vagas mais antigas que N dias (default: 30)
# Baseado em publishedDate da API
GUPY_MAX_AGE_DAYS=30

# Timeout por request HTTP em ms (default: 15000)
GUPY_TIMEOUT_MS=15000

# Máximo de retries em falhas transitórias (default: 3)
GUPY_MAX_RETRIES=3

# Delay base do backoff exponencial em ms (default: 1000)
# Retries: 1s, 2s, 4s, 8s... (limitado por GUPY_MAX_RETRIES)
GUPY_BASE_DELAY_MS=1000

# Delay máximo do backoff em ms (default: 30000)
GUPY_MAX_DELAY_MS=30000

# ============================================
# GUPY LLM EXTRACTION (opcional - extração via Gemini)
# ============================================
# Ativar extração de vagas via Gemini em vez de seletores CSS (default: false)
# Exige GEMINI_API_KEY (obrigatória quando a flag estiver true)
GUPY_USE_LLM_EXTRACTION=false

# Modelo Gemini usado na extração (default: gemini-1.5-flash)
GEMINI_EXTRACTION_MODEL=gemini-1.5-flash

# Máximo de tokens de saída por chamada (default: 8000)
GEMINI_EXTRACTION_MAX_TOKENS=8000

# Cards de vaga enviados por chamada ao Gemini (default: 10)
GEMINI_EXTRACTION_BATCH_SIZE=10

# ============================================
# OPERACIONAL
# ============================================
# Arquivo de seen IDs (default: data/seen.json)
SEEN_FILE=data/seen.json

# Log level (debug, info, warn, error) - default: info
LOG_LEVEL=info